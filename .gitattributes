# Normalize text for GitHub and cross-platform contributors.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# Keep binary assets unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.moc3 binary
*.vrm binary
*.glb binary
*.wav binary
*.mp3 binary
*.mp4 binary
